{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run PSScriptAnalyzer",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "Invoke-ScriptAnalyzer -Path ./src -Recurse -ReportSummary"
      ],
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Pester Tests",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "Invoke-Pester -Path ./src -Output Detailed"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Import Module",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "Import-Module ./src/MsrcSecurityUpdates/MsrcSecurityUpdates.psd1 -Force; Get-Command -Module MsrcSecurityUpdates"
      ],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Test Module Manifest",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "Test-ModuleManifest -Path ./src/MsrcSecurityUpdates/MsrcSecurityUpdates.psd1"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
